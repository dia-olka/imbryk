---
pagination:
  data: articlePages
  size: 1
  alias: ap
permalink: "edition/{{ ap.editionDate }}/{{ ap.newspaperId }}/{{ ap.slug }}/index.html"
layout: layouts/base.njk
ogType: article
eleventyComputed:
  title: "{{ ap.article.headline }} — {{ ap.newspaperName }} — Imbryk Gazette"
  ogTitle: "{{ ap.article.headline }} — {{ ap.newspaperName }}"
  description: "{{ ap.article.body | truncateChars(155) }}"
  ogDescription: "{{ ap.article.body | truncateChars(200) }}"
  ogImage: "{% if ap.article.image_url %}{{ ap.article.image_url }}{% elif ap.heroImageUrl %}{{ ap.heroImageUrl }}{% endif %}"
  ogImageAlt: "{{ ap.article.imagePrompt | default(ap.article.headline) }}"
  googleFontsUrl: "{{ ap.googleFontsUrl }}"
---

{% set persona = personas.newspapers | findPersona(ap.newspaperId) %}

{% set breadcrumbs = [
  {label: "Home", url: "/"},
  {label: ap.editionDate | dateDisplay, url: "/edition/" + ap.editionDate + "/"},
  {label: ap.newspaperName, url: "/edition/" + ap.editionDate + "/" + ap.newspaperId + "/"},
  {label: ap.article.headline, url: ""}
] %}
{% include "breadcrumb.njk" %}

{# Article JSON-LD structured data #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ ap.article.headline | dump | safe }},
  "datePublished": "{{ ap.editionDate }}",
  "author": {
    "@type": "Organization",
    "name": {{ ap.newspaperName | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Imbryk Gazette",
    "url": "{{ site.url }}/"
  }{% if ap.article.image_url %},
  "image": "{{ ap.article.image_url }}"{% endif %},
  "description": {{ ap.article.body | truncateChars(200) | dump | safe }},
  "mainEntityOfPage": "{{ site.url }}/edition/{{ ap.editionDate }}/{{ ap.newspaperId }}/{{ ap.slug }}/"
}
</script>

<div class="newspaper" style="{{ ap.cssVars }}">

  {% set mastheadName = ap.newspaperName %}
  {% set mastheadTagline = persona.tagline if persona else "" %}
  {% set mastheadDate = ap.editionDate %}
  {% include "newspaper-masthead.njk" %}

  <article id="{{ ap.slug }}">
    <h1 class="article-full__title">
      {{ ap.article.headline }}
      <a href="#{{ ap.slug }}" class="anchor-link" aria-label="Permalink to this article">#</a>
    </h1>

    <p class="article-full__meta">
      {{ ap.editionDate | dateDisplay }} · {{ ap.article.word_count }} words
    </p>

    {% if ap.article.image_url %}
      <figure class="article-full__image">
        <img src="{{ ap.article.image_url }}"
             alt="{{ ap.article.imagePrompt }}"
             loading="lazy"
             width="800"
             height="450"
             srcset="{{ ap.article.image_url }} 800w"
             sizes="(max-width: 800px) 100vw, 800px">
        <figcaption>{{ ap.article.imagePrompt }}</figcaption>
      </figure>
    {% endif %}

    <div class="article-full__body">
      {{ ap.article.body | markdown | safe }}
    </div>
  </article>

  {% set prevArticle = ap.prevArticle %}
  {% set nextArticle = ap.nextArticle %}
  {% set articleEditionDate = ap.editionDate %}
  {% set articleNewspaperId = ap.newspaperId %}
  {% set articleNewspaperName = ap.newspaperName %}
  {% include "article-nav.njk" %}

</div>
