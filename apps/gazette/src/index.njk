---
layout: layouts/base.njk
bodyClass: page-home
title: "Today's Edition — Imbryk Gazette"
description: "Today's AI-generated perspectives on how world events reshape civilisation — six ideologically distinct newspapers, each powered by advanced AI."
ogType: website
---

{% set edition = editions | latestEdition %}

{% if edition %}
<div class="edition-banner">
  <p class="edition-dateline">
    <time datetime="{{ edition.date | dateISO }}">{{ edition.date | dateDisplay }}</time>
    &mdash; Today&rsquo;s Edition
  </p>
  {% set neighbours = editions | editionNeighbours(edition.date) %}
  <nav class="curator-nav-row" aria-label="Browse editions by date">
    <div class="curator-nav-row__next">
      {% if neighbours.next %}
        <a href="/edition/{{ neighbours.next }}/" class="curator-nav-row__link">
          <span class="curator-nav-row__arrow" aria-hidden="true">&larr;</span>
          <span class="curator-nav-row__meta">
            <span class="curator-nav-row__label">Newer edition</span>
            <span class="curator-nav-row__date">
              <span class="curator-nav-row__date-full">{{ neighbours.next | dateDisplay }}</span>
              <span class="curator-nav-row__date-short">{{ neighbours.next | dateShort }}</span>
            </span>
          </span>
        </a>
      {% endif %}
    </div>
    <div class="curator-nav-row__center">
      {% if edition.curator_synthesis %}
        <a href="/edition/{{ edition.date }}/curator/"
           class="curator-banner"
           style="{{ personas.curator.cssVars }}"
           aria-label="{{ personas.curator.paperName }} — Synthesis &amp; Analysis">
          <span class="curator-banner__label">{{ personas.curator.paperName }}</span>
          <span class="curator-banner__text">{{ (edition.curator_synthesis.text or edition.curator_synthesis.analysis or "") | truncateWords(30) }}</span>
          <span class="curator-banner__cta" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
    <div class="curator-nav-row__prev">
      {% if neighbours.prev %}
        <a href="/edition/{{ neighbours.prev }}/" class="curator-nav-row__link curator-nav-row__link--prev">
          <span class="curator-nav-row__meta">
            <span class="curator-nav-row__label">Older edition</span>
            <span class="curator-nav-row__date">
              <span class="curator-nav-row__date-full">{{ neighbours.prev | dateDisplay }}</span>
              <span class="curator-nav-row__date-short">{{ neighbours.prev | dateShort }}</span>
            </span>
          </span>
          <span class="curator-nav-row__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </nav>
</div>
{% endif %}

{% if edition %}
  <ul class="front-page-grid" role="list">
    {% for newspaper in edition.newspapers %}
      {% set cardPersona = personas.newspapers | findPersona(newspaper.newspaper_id) %}
      {% set cardNewspaper = newspaper %}
      {% set cardEditionDate = edition.date %}
      {% include "front-page-card.njk" %}
    {% endfor %}
  </ul>
{% else %}
  <p>No editions published yet. Check back soon.</p>
{% endif %}
