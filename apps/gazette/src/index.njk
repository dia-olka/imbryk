---
layout: layouts/base.njk
bodyClass: page-home
title: "Today's Edition — Imbryk Gazette"
description: "Today's AI-generated perspectives on how world events reshape civilisation — six ideologically distinct newspapers, each powered by advanced AI."
ogType: website
---

{% set edition = editions | latestEdition %}

{% if edition %}
<div class="edition-banner">
  {% set neighbours = editions | editionNeighbours(edition.date) %}
  <nav class="edition-date-bar" aria-label="Browse editions by date">
    <div class="edition-date-bar__prev">
      {% if neighbours.next %}
        <a href="/edition/{{ neighbours.next }}/">
          <span aria-hidden="true">&larr;</span>
          <span class="edition-date-bar__date-full">{{ neighbours.next | dateDisplay }}</span>
          <span class="edition-date-bar__date-short">{{ neighbours.next | dateShort }}</span>
        </a>
      {% endif %}
    </div>
    <div class="edition-date-bar__center">
      {% if edition.curator_synthesis %}
        <a href="/edition/{{ edition.date }}/curator/"
           class="curator-banner"
           style="{{ personas.curator.cssVars }}"
           aria-label="{{ personas.curator.paperName }} — Synthesis &amp; Analysis">
          <span class="curator-banner__label">{{ personas.curator.paperName }}</span>
          <span class="curator-banner__cta" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
    <div class="edition-date-bar__next">
      {% if neighbours.prev %}
        <a href="/edition/{{ neighbours.prev }}/">
          <span class="edition-date-bar__date-full">{{ neighbours.prev | dateDisplay }}</span>
          <span class="edition-date-bar__date-short">{{ neighbours.prev | dateShort }}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </nav>
</div>
{% endif %}

{% if edition %}
  <ul class="front-page-grid" role="list">
    {% for newspaper in edition.newspapers %}
      {% set cardPersona = personas.newspapers | findPersona(newspaper.newspaper_id) %}
      {% set cardNewspaper = newspaper %}
      {% set cardEditionDate = edition.date %}
      {% include "front-page-card.njk" %}
    {% endfor %}
  </ul>
{% else %}
  <p>No editions published yet. Check back soon.</p>
{% endif %}
