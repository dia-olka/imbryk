---
pagination:
  data: translatedIndexPages
  size: 1
  alias: tip
permalink: "{{ tip.lang }}/index.html"
layout: layouts/base.njk
bodyClass: page-home
ogType: website
eleventyComputed:
  title: "{{ tip.ui.todaysEdition | default(\"Today's Edition\") }} — Imbryk Gazette"
  description: "{{ tip.ui.descriptor | default(\"Today's AI-generated perspectives on how world events reshape civilisation.\") }}"
  ogImage: "{% if tip.edition.newspapers[0].heroImageUrl %}{{ tip.edition.newspapers[0].heroImageUrl }}{% endif %}"
  pageLang: "{{ tip.lang }}"
  pageDir: "{{ tip.langDir }}"
  pageLocale: "{{ tip.langLocale }}"
---

{% set edition = tip.edition %}

{% if edition %}
<div class="edition-banner">
  {% set neighbours = tip.allEditions | editionNeighbours(edition.date) %}
  <nav class="edition-date-bar" aria-label="{{ tip.ui.browseEditions | default('Browse editions by date') }}">
    <div class="edition-date-bar__prev">
      {% if neighbours.next %}
        <a href="/edition/{{ neighbours.next }}/{{ tip.lang }}/">
          <span aria-hidden="true">&larr;</span>
          <span class="edition-date-bar__date-full">{{ neighbours.next | dateDisplay(tip.lang) }}</span>
          <span class="edition-date-bar__date-short">{{ neighbours.next | dateShort(tip.lang) }}</span>
        </a>
      {% endif %}
    </div>
    <div class="edition-date-bar__center">
      {% if edition.curator_synthesis %}
        <a href="/edition/{{ edition.date }}/curator/"
           class="curator-banner"
           style="{{ personas.curator.cssVars }}"
           aria-label="{{ personas.curator.paperName }} — {{ tip.ui.synthesis | default('Synthesis &amp; Analysis') }}">
          <span class="curator-banner__label">{{ personas.curator.paperName }}</span>
          <span class="curator-banner__cta" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
    <div class="edition-date-bar__next">
      {% if neighbours.prev %}
        <a href="/edition/{{ neighbours.prev }}/{{ tip.lang }}/">
          <span class="edition-date-bar__date-full">{{ neighbours.prev | dateDisplay(tip.lang) }}</span>
          <span class="edition-date-bar__date-short">{{ neighbours.prev | dateShort(tip.lang) }}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </nav>
</div>
{% endif %}

{% if edition %}
  <ul class="front-page-grid" role="list">
    {% for newspaper in edition.newspapers %}
      {% set cardPersona = personas.newspapers | findPersona(newspaper.newspaper_id) %}
      {% set cardNewspaper = newspaper %}
      {% set cardEditionDate = edition.date %}
      {% set cardLangSuffix = tip.lang %}
      {% set cardUi = tip.ui %}
      {% include "front-page-card-translated.njk" %}
    {% endfor %}
  </ul>
{% else %}
  <p>{{ tip.ui.noEditions | default("No editions published yet. Check back soon.") }}</p>
{% endif %}
