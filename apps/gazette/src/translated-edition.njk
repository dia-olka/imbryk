---
pagination:
  data: translatedEditionPages
  size: 1
  alias: tep
permalink: "edition/{{ tep.editionDate }}/{{ tep.lang }}/index.html"
layout: layouts/base.njk
ogType: website
eleventyComputed:
  title: "{{ tep.editionDate | dateDisplay }} — Imbryk Gazette"
  description: "{{ tep.editionDate | dateDisplay }} — {{ tep.langName }}"
  ogImage: "{% if tep.newspapers[0].heroImageUrl %}{{ tep.newspapers[0].heroImageUrl }}{% endif %}"
  pageLang: "{{ tep.lang }}"
  pageDir: "{{ tep.langDir }}"
  pageLocale: "{{ tep.langLocale }}"
---

{% set breadcrumbs = [
  {label: tep.ui.home | default("Home"), url: "/" + tep.lang + "/"},
  {label: tep.editionDate | dateDisplay(tep.lang), url: ""}
] %}
{% include "breadcrumb.njk" %}

{% set neighbours = editions | editionNeighbours(tep.editionDate) %}
<nav class="edition-date-bar" aria-label="{{ tep.ui.browseEditions | default('Browse editions by date') }}">
  <div class="edition-date-bar__prev">
    {% if neighbours.next %}
      <a href="/edition/{{ neighbours.next }}/{{ tep.lang }}/">
        <span aria-hidden="true">&larr;</span>
        <span class="edition-date-bar__date-full">{{ neighbours.next | dateDisplay(tep.lang) }}</span>
        <span class="edition-date-bar__date-short">{{ neighbours.next | dateShort(tep.lang) }}</span>
      </a>
    {% endif %}
  </div>
  <div class="edition-date-bar__current">
    <time datetime="{{ tep.editionDate | dateISO }}">{{ tep.editionDate | dateDisplay(tep.lang) }}</time>
  </div>
  <div class="edition-date-bar__next">
    {% if neighbours.prev %}
      <a href="/edition/{{ neighbours.prev }}/{{ tep.lang }}/">
        <span class="edition-date-bar__date-full">{{ neighbours.prev | dateDisplay(tep.lang) }}</span>
        <span class="edition-date-bar__date-short">{{ neighbours.prev | dateShort(tep.lang) }}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>
</nav>

{% if tep.curatorSynthesis %}
  <a href="/edition/{{ tep.editionDate }}/curator/"
     class="curator-banner"
     style="{{ personas.curator.cssVars }}"
     aria-label="{{ personas.curator.paperName }} — {{ tep.ui.synthesis | default('Synthesis &amp; Analysis') }}">
    <span class="curator-banner__label">{{ personas.curator.paperName }}</span>
    <span class="curator-banner__text">{{ (tep.curatorSynthesis.text or tep.curatorSynthesis.analysis or "") | truncateChars(120) }}</span>
    <span class="curator-banner__cta" aria-hidden="true">&rarr;</span>
  </a>
{% endif %}

<ul class="front-page-grid" role="list">
  {% for newspaper in tep.newspapers %}
    {% set cardPersona = personas.newspapers | findPersona(newspaper.newspaper_id) %}
    {% set cardNewspaper = newspaper %}
    {% set cardEditionDate = tep.editionDate %}
    {% set cardLangSuffix = tep.lang %}
    {% set cardId = newspaper.newspaper_id %}
    {% set cardUi = tep.ui %}
    {% include "front-page-card-translated.njk" %}
  {% endfor %}
</ul>
