---
pagination:
  data: editions
  size: 1
  alias: edition
permalink: "edition/{{ edition.date }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "Edition {{ edition.date | dateDisplay }} — Imbryk Gazette"
---

{% set breadcrumbs = [
  {label: "Home", url: "/"},
  {label: edition.date | dateDisplay, url: ""}
] %}
{% include "breadcrumb.njk" %}

<div class="page-header">
  <h1>Edition</h1>
  <p class="date"><time datetime="{{ edition.date | dateISO }}">{{ edition.date | dateDisplay }}</time></p>
</div>

<ul class="bento-grid" role="list">
  {% for newspaper in edition.newspapers %}
    {% set cardPersona = personas.newspapers | findPersona(newspaper.newspaper_id) %}
    {% set cardNewspaper = newspaper %}
    {% set cardEditionDate = edition.date %}
    {% include "newspaper-card.njk" %}
  {% endfor %}

  {# Curator card #}
  {% if edition.curator_synthesis %}
    <li>
      <a href="/edition/{{ edition.date }}/curator/"
         class="newspaper-card"
         style="{{ personas.curator.cssVars }}">
        <h2 class="newspaper-card__name">{{ personas.curator.paperName }}</h2>
        <p class="newspaper-card__tagline">{{ personas.curator.tagline }}</p>
        <p class="article-preview__excerpt">{{ edition.curator_synthesis.analysis | truncateWords(25) }}</p>
        <p class="newspaper-card__count">Synthesis &amp; Analysis</p>
      </a>
    </li>
  {% endif %}
</ul>
