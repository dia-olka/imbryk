---
pagination:
  data: newspaperPages
  size: 1
  alias: np
permalink: "edition/{{ np.editionDate }}/{{ np.newspaperId }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ np.newspaperName }} — {{ np.editionDate | dateDisplay }} — Imbryk Gazette"
---

{% set persona = personas.newspapers | findPersona(np.newspaperId) %}

{% set breadcrumbs = [
  {label: "Home", url: "/"},
  {label: np.editionDate | dateDisplay, url: "/edition/" + np.editionDate + "/"},
  {label: np.newspaperName, url: ""}
] %}
{% include "breadcrumb.njk" %}

{% set siblingNewspaperIds = np.allNewspaperIds %}
{% set currentNewspaperId = np.newspaperId %}
{% set siblingEditionDate = np.editionDate %}
{% include "sibling-nav.njk" %}

<div class="newspaper" style="{{ np.cssVars }}">

  {% set mastheadName = np.newspaperName %}
  {% set mastheadTagline = persona.tagline if persona else "" %}
  {% set mastheadDate = np.editionDate %}
  {% include "newspaper-masthead.njk" %}

  {% if np.heroImageUrl %}
    <figure class="newspaper__hero">
      <img src="{{ np.heroImageUrl }}"
           alt="{{ np.frontPageImagePrompt }}"
           loading="eager"
           width="800"
           height="450"
           srcset="{{ np.heroImageUrl }} 800w"
           sizes="(max-width: 800px) 100vw, 800px"
           class="newspaper__hero-img">
      <figcaption>{{ np.frontPageImagePrompt }}</figcaption>
    </figure>
  {% endif %}

  {% if persona %}
    <details class="identity-card">
      <summary><strong>About this newspaper</strong></summary>
      <p class="detail-label">Ideology</p>
      <p>{{ persona.ideology }}</p>
      <p class="detail-label">Political Leaning</p>
      <p>{{ persona.politicalLeaning }}</p>
      <p class="detail-label">Editorial Biases</p>
      <ul>
        {% for bias in persona.biases %}
          <li>{{ bias }}</li>
        {% endfor %}
      </ul>
      <p class="detail-label">Blindspots</p>
      <ul>
        {% for blindspot in persona.blindspots %}
          <li>{{ blindspot }}</li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}

  <section aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="visually-hidden">Articles</h2>

    {% for article in np.articles %}
      {% set previewArticle = article %}
      {% set previewEditionDate = np.editionDate %}
      {% set previewNewspaperId = np.newspaperId %}
      {% include "article-preview.njk" %}
    {% endfor %}
  </section>

  {% if np.inBrief.length %}
    <section class="in-brief" aria-labelledby="in-brief-heading">
      <h2 id="in-brief-heading">In Brief</h2>

      {% for item in np.inBrief %}
        <div class="in-brief-item">
          <h3>{{ item.headline }}</h3>
          <p>{{ item.summary }}</p>
        </div>
      {% endfor %}
    </section>
  {% endif %}

  {% if np.editorsNote %}
    <aside class="editors-note" aria-label="Editor's note">
      <h2>Editor's Note</h2>
      <p>{{ np.editorsNote }}</p>
    </aside>
  {% endif %}

  <a href="/edition/{{ np.editionDate }}/" class="back-link">← Back to edition overview</a>

</div>
