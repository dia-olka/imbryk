---
pagination:
  data: editions
  size: 1
  alias: edition
permalink: "edition/{{ edition.date }}/curator/index.html"
layout: layouts/base.njk
ogType: article
eleventyComputed:
  title: "Curator Synthesis — {{ edition.date | dateDisplay }} — Imbryk Gazette"
  ogTitle: "The Curator — {{ edition.date | dateDisplay }}"
  description: "Where six AI newspapers converge, clash, and leave gaps. {{ edition.date | dateDisplay }} synthesis."
  ogDescription: "Where six AI newspapers converge, clash, and leave gaps."
---

{% set synthesis = edition.curator_synthesis %}
{% set curator = personas.curator %}
{% set allNewspaperIds = [] %}
{% for newspaper in edition.newspapers %}
  {% set _ = allNewspaperIds.push(newspaper.newspaper_id) %}
{% endfor %}

{% set breadcrumbs = [
  {label: "Home", url: "/"},
  {label: edition.date | dateDisplay, url: "/edition/" + edition.date + "/"},
  {label: curator.paperName, url: ""}
] %}
{% include "breadcrumb.njk" %}

{% set siblingNewspaperIds = allNewspaperIds %}
{% set currentNewspaperId = "curator" %}
{% set siblingEditionDate = edition.date %}
{% include "sibling-nav.njk" %}

{# Curator Article JSON-LD structured data #}
{% if synthesis %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Curator Synthesis — {{ edition.date | dateDisplay }}",
  "datePublished": "{{ edition.date }}",
  "author": {
    "@type": "Organization",
    "name": "The Curator"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Imbryk Gazette",
    "url": "{{ site.url }}/"
  },
  "description": "How six AI editorial perspectives converge and diverge on {{ edition.date | dateDisplay }}'s world-shaping events.",
  "mainEntityOfPage": "{{ site.url }}/edition/{{ edition.date }}/curator/"
}
</script>
{% endif %}

<div class="newspaper" data-persona="curator" style="{{ curator.cssVars }}">

  {% set mastheadName = curator.paperName %}
  {% set mastheadTagline = curator.tagline %}
  {% set mastheadDate = edition.date %}
  {% include "newspaper-masthead.njk" %}

  {% if synthesis %}
    {# ─── V2: structured spectrum visualization ─── #}
    {% if synthesis.version == 2 %}

      {# Metrics bar — 3-column grid #}
      <div class="curator-metrics" role="status" aria-label="Edition analysis summary">
        <span class="curator-metric">
          <span class="curator-metric__count">{{ synthesis.consensus | length }}</span>
          <span class="curator-metric__label">consensus</span>
        </span>
        <span class="curator-metric">
          <span class="curator-metric__count">{{ synthesis.fault_lines | length }}</span>
          <span class="curator-metric__label">fault lines</span>
        </span>
        {% if synthesis.gaps and synthesis.gaps.length %}
        <span class="curator-metric">
          <span class="curator-metric__count">{{ synthesis.gaps | length }}</span>
          <span class="curator-metric__label">gaps</span>
        </span>
        {% endif %}
      </div>

      <div class="curator-lede">
        <p>Six AI editorial perspectives analysed. Here is where they converge, clash, and leave gaps.</p>
      </div>

      {# Legend — newspaper color key #}
      <div class="curator-legend" aria-label="Newspaper colour key">
        {% for np in personas.newspapers %}
        <span class="curator-legend__item">
          <span class="curator-legend__dot" style="background: {{ np.designTokens.primary }}"></span>
          {{ np.paperName }}
        </span>
        {% endfor %}
      </div>

      {# Consensus #}
      {% if synthesis.consensus and synthesis.consensus.length %}
      <section class="synthesis-section" aria-label="Consensus">
        <h2>
          <span class="sec-dot sec-dot--consensus"></span>
          Consensus — all {{ allNewspaperIds | length }} voices agree
        </h2>
        {% for item in synthesis.consensus %}
        <div class="consensus-item">
          <span class="c-num">{{ loop.index }}</span>
          <div class="c-body">
            <p class="c-text">{{ item.text }}</p>
            {% if item.voices and item.voices.length %}
            <div class="voice-chips" aria-label="Newspapers in agreement">
              {% for voiceId in item.voices %}
                {% set vp = personas.newspapers | findPersona(voiceId) %}
                {% if vp %}
                <span class="voice-chip"
                      style="background: {{ vp.designTokens.primary }}"
                      title="{{ vp.paperName }}"
                      tabindex="0"
                      role="img"
                      aria-label="{{ vp.paperName }}">{{ vp.paperName | personaInitial }}</span>
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {# Fault Lines with spectrum #}
      {% if synthesis.fault_lines and synthesis.fault_lines.length %}
      <section class="synthesis-section" aria-label="Fault Lines">
        <h2>
          <span class="sec-dot sec-dot--faultlines"></span>
          Fault Lines — where perspectives diverge
        </h2>
        {% for fl in synthesis.fault_lines %}
        <div class="faultline">
          <div class="faultline__header">
            <span class="f-num">{{ loop.index }}</span>
            <h3 class="faultline__topic">{{ fl.topic }}</h3>
          </div>
          <div class="spectrum" role="img" aria-label="Spectrum: {{ fl.label_left }} to {{ fl.label_right }}">
            <div class="spectrum__track">
              <span class="spectrum__track-bg"></span>
              <span class="spectrum__track-mid"></span>
              {% for stance in fl.stances %}
                {% set sp = personas.newspapers | findPersona(stance.newspaper_id) %}
                {% if sp %}
                <span class="spectrum__dot"
                      style="left: {{ stance.score }}%; background: {{ sp.designTokens.primary }}"
                      title="{{ sp.paperName }}"
                      tabindex="0"
                      role="img"
                      aria-label="{{ sp.paperName }}: {{ stance.score }}%">{{ sp.paperName | personaInitial }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="spectrum-labels">
            <span class="spectrum-label spectrum-label--left">{{ fl.label_left }}</span>
            <span class="spectrum-label spectrum-label--right">{{ fl.label_right }}</span>
          </div>
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {# Gaps #}
      {% if synthesis.gaps and synthesis.gaps.length %}
      <section class="synthesis-section" aria-label="Coverage Gaps">
        <h2>
          <span class="sec-dot sec-dot--gaps"></span>
          Gaps — what no one covered
        </h2>
        {% for gap in synthesis.gaps %}
        <div class="gap-item">
          <span class="gap-icon" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1"/><path d="M5 3v2L6.5 6.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
          </span>
          <div class="gap-body">
            <p class="gap-text">{{ gap.description }}</p>
            <span class="gap-tag">{{ gap.topic }}</span>
          </div>
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {# What to Watch #}
      {% if synthesis.what_to_watch and synthesis.what_to_watch.length %}
      <section class="synthesis-section" aria-label="What to Watch">
        <h2>
          <span class="sec-dot sec-dot--watch"></span>
          What to Watch
        </h2>
        <ol>
          {% for item in synthesis.what_to_watch %}
            <li>{{ item }}</li>
          {% endfor %}
        </ol>
      </section>
      {% endif %}

    {# ─── V1: plain string lists ─── #}
    {% elif synthesis.consensus %}
      <section class="synthesis-section" aria-label="Curator synthesis">
        {% set sections = [
          {key: "consensus", label: "Consensus"},
          {key: "fault_lines", label: "Fault Lines"},
          {key: "uncovered_angles", label: "Uncovered Angles"},
          {key: "what_to_watch", label: "What to Watch"}
        ] %}
        {% for section in sections %}
          {% set items = synthesis[section.key] %}
          {% if items and items.length %}
            <h2>{{ section.label }}</h2>
            <ol>
              {% for item in items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ol>
          {% endif %}
        {% endfor %}
      </section>

    {# ─── Legacy: free-form text ─── #}
    {% else %}
      <section class="synthesis-section" aria-label="Curator synthesis">
        {{ (synthesis.text or synthesis.analysis or "") | markdown | safe }}
      </section>
    {% endif %}

  {% else %}
    <p>No curator synthesis available for this edition.</p>
  {% endif %}

  {% set siblingNewspaperIds = allNewspaperIds %}
  {% set currentNewspaperId = "curator" %}
  {% set siblingEditionDate = edition.date %}
  {% include "sibling-nav.njk" %}

  {# Editions are sorted newest-first; prev = newer, next = older #}
  {% set editionNavNext = pagination.pages[pagination.pageNumber + 1].date if pagination.pageNumber + 1 < pagination.pages.length else null %}
  {% set editionNavPrev = pagination.pages[pagination.pageNumber - 1].date if pagination.pageNumber > 0 else null %}
  {% set editionNavNewspaperId = "curator" %}
  {% set editionNavNewspaperName = "The Curator" %}
  {% include "edition-nav.njk" %}

</div>
