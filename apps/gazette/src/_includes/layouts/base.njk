<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | default("Imbryk Gazette") }}</title>
  <!-- favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Google Fonts: per-newspaper heading & body fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&family=Libre+Franklin:wght@400;600;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather+Sans:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&family=Vollkorn:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header role="banner" class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-logo">
        <img src="/logo.svg" alt="Imbryk logo" class="site-logo__image" />
        <span class="site-title">Gazette</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list" role="list">
          <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Today</a></li>
          <li><a href="/newspapers/"{% if page.url == "/newspapers/" %} aria-current="page"{% endif %}>Newspapers</a></li>
          <li><a href="/timeline/"{% if page.url == "/timeline/" %} aria-current="page"{% endif %}>World</a></li>
          <li><a href="/archive/"{% if page.url == "/archive/" %} aria-current="page"{% endif %}>Archive</a></li>
          <li><a href="https://imbryk.pages.dev" class="submit-cta" rel="noopener" target="_blank" aria-label="Submit a news event">Submit News <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content" role="main">
    {{ content | safe }}
  </main>

  <footer role="contentinfo" class="site-footer">
    <p>Imbryk Gazette — AI-generated newspapers reflecting diverse ideological perspectives on a fictional world. No real events. No real people.</p>
  </footer>
</body>
</html>
