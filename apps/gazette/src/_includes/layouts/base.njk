<!DOCTYPE html>
<html lang="{{ pageLang | default('en') }}" dir="{{ pageDir | default('ltr') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | default("Imbryk Gazette") }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <meta name="theme-color" content="#1a1a2e">
  <link rel="canonical" href="{{ canonicalUrl | default(site.url + page.url) }}">

  {% if hreflangAlternates %}
  {% for alt in hreflangAlternates %}
  <link rel="alternate" hreflang="{{ alt.code }}" href="{{ site.url }}{{ alt.url }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ hreflangDefault | default(page.url) }}">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle | default(title) | default(site.name) }}">
  <meta property="og:description" content="{{ ogDescription | default(description) | default(site.description) }}">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:url" content="{{ canonicalUrl | default(site.url + page.url) }}">
  {% set resolvedOgImage = ogImage if ogImage else (site.url + site.ogImageFallback) %}
  <meta property="og:image" content="{{ resolvedOgImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% if ogImageAlt %}
  <meta property="og:image:alt" content="{{ ogImageAlt }}">
  {% endif %}
  <meta property="og:locale" content="{{ pageLocale | default(site.locale) }}">

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle | default(title) | default(site.name) }}">
  <meta name="twitter:description" content="{{ ogDescription | default(description) | default(site.description) }}">
  <meta name="twitter:image" content="{{ resolvedOgImage }}">
  {% if ogImageAlt %}
  <meta name="twitter:image:alt" content="{{ ogImageAlt }}">
  {% endif %}

  <!-- favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Preconnect to asset origins for faster resource fetching -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if site.r2Origin %}
  <link rel="preconnect" href="{{ site.r2Origin }}">
  {% endif %}
  {# Google Fonts: always load non-render-blocking with media="print" swap trick #}
  {% if googleFontsUrl %}
  <link rel="stylesheet" href="{{ googleFontsUrl | safe }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ googleFontsUrl | safe }}"></noscript>
  {% else %}
  {# Homepage / multi-persona pages: async-load the full font bundle #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&family=Libre+Franklin:wght@400;600;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather+Sans:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&family=Vollkorn:ital,wght@0,400;0,700;1,400&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&family=Libre+Franklin:wght@400;600;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather+Sans:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&family=Vollkorn:ital,wght@0,400;0,700;1,400&display=swap"></noscript>
  {% endif %}
  <link rel="stylesheet" href="/css/style.css">

  <!-- JSON-LD: WebSite (every page) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/"
  }
  </script>

  {% if jsonLd %}
  <script type="application/ld+json">
  {{ jsonLd | safe }}
  </script>
  {% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#main-content" class="skip-link">{{ pageUi.skipToMain | default("Skip to main content") }}</a>

  <header role="banner" class="site-header">
    <div class="site-header__inner">
      <div class="site-header__brand">
        <a href="/" class="site-logo">
          <img src="/logo.svg" alt="Imbryk logo" class="site-logo__image" />
          <span class="site-title">Gazette</span>
        </a>
        <p class="site-tagline">{{ pageUi.tagline | default("Six AI minds. <em>One world in motion.</em>") | safe }}</p>
        <p class="site-descriptor">{{ pageUi.descriptor | default("Submit your news &mdash; see how six powerful AI systems cover it.") | safe }}</p>
      </div>
      <a href="{{ site.submitUrl }}" class="site-submit-cta" rel="noopener" target="_blank" aria-label="{{ pageUi.submit | default('Submit') }}">
        {{ pageUi.submit | default("Submit") }} <span aria-hidden="true">↗</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list" role="list">
          <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ pageUi.today | default("Today") }}</a></li>
          <li><a href="/timeline/"{% if page.url == "/timeline/" %} aria-current="page"{% endif %}>{{ pageUi.world | default("World") }}</a></li>
          <li><a href="/archive/"{% if page.url == "/archive/" %} aria-current="page"{% endif %}>{{ pageUi.archive | default("Archive") }}</a></li>
          <li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>{{ pageUi.about | default("About") }}</a></li>
        </ul>
      </nav>
      {% include "language-switcher.njk" %}
    </div>
  </header>

  <main id="main-content" role="main">
    {{ content | safe }}
  </main>

  <footer role="contentinfo" class="site-footer">
    <p><a href="/newspapers/">Imbryk Gazette</a> &mdash; {{ pageUi.footerText | default("six AI perspectives on world events.") }}</p>
    <nav class="site-footer__links" aria-label="Footer links">
      <ul role="list">
        <li><a href="/about/">{{ pageUi.about | default("About") }}</a></li>
        <li><a href="/policies/">{{ pageUi.policies | default("Policies") }}</a></li>
        <li><a href="https://bsky.app/profile/imbryk-gazette.bsky.social" rel="me noopener" target="_blank">Bluesky</a></li>
      </ul>
    </nav>
  </footer>

  {% if site.cfWebAnalyticsToken %}
  <!-- Cloudflare Web Analytics — privacy-first, no cookies -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "{{ site.cfWebAnalyticsToken }}"}'></script>
  {% endif %}
</body>
</html>
