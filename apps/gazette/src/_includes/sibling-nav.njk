{# Sibling newspaper navigation
   Usage: {% include "sibling-nav.njk" %}
   Expects:
     - siblingNewspaperIds: array of newspaper IDs in this edition
     - currentNewspaperId: the active newspaper ID (for aria-current)
     - siblingEditionDate: the edition date for URL construction
     - personas: the personas data object (for looking up names)
   Optional:
     - siblingLangSuffix: language code for translated URLs (e.g. "es")
     - siblingUi: UI strings with newspaperNames for translated names
#}

{% if siblingNewspaperIds and siblingNewspaperIds.length %}
<nav class="sibling-nav" aria-label="Newspapers in this edition">
  <ul class="sibling-nav__list" role="list">
    {% for npId in siblingNewspaperIds %}
      {% set np_persona = personas.newspapers | findPersona(npId) %}
      {% set npDisplayName = siblingUi.newspaperNames[npId] if (siblingUi and siblingUi.newspaperNames and siblingUi.newspaperNames[npId]) else (np_persona.paperName if np_persona else npId) %}
      <li>
        <a href="/edition/{{ siblingEditionDate }}/{{ npId }}/{{ siblingLangSuffix + '/' if siblingLangSuffix else '' }}"{% if npId == currentNewspaperId %} aria-current="page"{% endif %}>
          {{ npDisplayName }}
        </a>
      </li>
    {% endfor %}
    <li>
      <a href="/edition/{{ siblingEditionDate }}/curator/"{% if currentNewspaperId == "curator" %} aria-current="page"{% endif %}>
        The Curator
      </a>
    </li>
  </ul>
</nav>
{% endif %}
