{# Front-page newspaper card — translated version
   Usage: {% include "front-page-card-translated.njk" %}
   Expects:
     - cardNewspaper: newspaper object with translated articles
     - cardPersona: persona object (paperName, tagline, cssVars)
     - cardEditionDate: edition date for URL
     - cardLangSuffix: language code for URL suffix (e.g. "es")
     - cardUi: (optional) UI strings object with newspaperNames/newspaperTaglines
#}

{% set leadHeadline = cardNewspaper.articles[0].headline if cardNewspaper.articles.length else "" %}
{% set npId = cardNewspaper.newspaper_id %}
{% set translatedName = cardUi.newspaperNames[npId] if (cardUi and cardUi.newspaperNames and cardUi.newspaperNames[npId]) else (cardPersona.paperName if cardPersona else cardNewspaper.newspaper_name) %}
{% set translatedTagline = cardUi.newspaperTaglines[npId] if (cardUi and cardUi.newspaperTaglines and cardUi.newspaperTaglines[npId]) else (cardPersona.tagline if cardPersona else "") %}

<li{% if cardId %} id="{{ cardId }}"{% endif %}>
  <a href="/edition/{{ cardEditionDate }}/{{ npId }}/{{ cardLangSuffix }}/"
     class="front-page-card"
     data-persona="{{ npId }}"
     style="{{ cardPersona.cssVars if cardPersona else '' }}"
     aria-label="{{ translatedName }} — {{ leadHeadline }}">

    {# Image layer — uses hero image when available #}
    {% if cardNewspaper.heroImageUrl %}
    <img src="{{ cardNewspaper.heroImageUrl }}"
         alt=""
         {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
         decoding="async"
         width="600"
         height="800"
         class="front-page-card__image">
    {% endif %}

    {# Top: Masthead overlay #}
    <div class="front-page-card__masthead">
      <h2 class="front-page-card__name">{{ translatedName }}</h2>
      {% if translatedTagline %}
        <p class="front-page-card__tagline">{{ translatedTagline }}</p>
      {% endif %}
    </div>

    {# Bottom: Lead headline overlay #}
    <div class="front-page-card__footer">
      {% if leadHeadline %}
        <p class="front-page-card__headline">{{ leadHeadline }}</p>
      {% endif %}
      <p class="front-page-card__count">
        {{ cardNewspaper.articles.length }} article{{ "s" if cardNewspaper.articles.length != 1 }}{% if cardNewspaper.in_brief.length %} · {{ cardNewspaper.in_brief.length }} in brief{% endif %}
      </p>
    </div>
  </a>
</li>
