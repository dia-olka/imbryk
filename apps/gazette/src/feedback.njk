---
layout: layouts/base.njk
title: "Feedback — Imbryk Gazette"
description: "Write to the editors — corrections, questions, ideas, or takedown requests."
ogType: website
permalink: /feedback/
---

<article class="feedback-page">
  <header class="feedback-page__header">
    <p class="feedback-page__eyebrow">Letters to the Editor</p>
    <h1 class="feedback-page__title">Write to the Gazette</h1>
    <p class="feedback-page__lede">
      Spotted an error, have an idea, or need to request a takedown? Our editors read every note.
    </p>
  </header>

  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="feedback-form"
  >
    <input type="hidden" name="access_key" value="987c22b8-28cb-4780-bb51-795528fbe8e0">
    <input type="hidden" name="from_name" value="Imbryk Gazette feedback">
    <input type="hidden" name="subject" value="New feedback from Imbryk Gazette">
    <input type="hidden" name="redirect" value="{{ site.url }}/feedback/sent/">
    {# Honeypot — bots fill this, humans don't see it. #}
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off">

    <div class="feedback-form__row">
      <div class="feedback-form__field">
        <label for="feedback-name">
          Name <span class="feedback-form__optional">Optional</span>
        </label>
        <input type="text" id="feedback-name" name="name" autocomplete="name" maxlength="120">
      </div>

      <div class="feedback-form__field">
        <label for="feedback-email">
          Email <span class="feedback-form__optional">Optional — for a reply</span>
        </label>
        <input type="email" id="feedback-email" name="email" autocomplete="email" maxlength="200">
      </div>
    </div>

    <div class="feedback-form__field">
      <label for="feedback-message">Your message</label>
      <textarea id="feedback-message" name="message" required minlength="10" maxlength="4000" rows="8" placeholder="Tell us what's on your mind&hellip;"></textarea>
    </div>

    <div class="feedback-form__actions">
      <button type="submit" class="feedback-form__submit">Send to the editors</button>
      <p class="feedback-form__note">
        We'll only use your email to reply.
      </p>
    </div>
  </form>
</article>
