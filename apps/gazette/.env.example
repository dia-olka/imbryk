# ── Gazette environment variables ─────────────────────────────────────────────
# Copy to .env for local development.
# Eleventy loads this automatically via dotenv (imported in eleventy.config.js).
# In production, set these as Cloudflare Pages environment variables.

# Public URL of this Gazette site (no trailing slash)
GAZETTE_URL=https://imbryk.news

# Public URL of the Imbryk submission app (no trailing slash)
IMBRYK_APP_URL=https://whisper.imbryk.news

# Public base URL for R2 edition storage (no trailing slash).
# When set, editions are loaded from R2. When unset, the local fixture is used.
R2_PUBLIC_URL=

# Sentry DSN for build-time and runtime error reporting (optional).
# When set, Zod validation failures and data load errors are sent to Sentry,
# including the full R2 URL of the offending file so operators can inspect it.
SENTRY_DSN=
