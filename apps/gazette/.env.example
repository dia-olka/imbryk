# ── Gazette environment variables ─────────────────────────────────────────────
# Copy to .env for local development.
# Eleventy loads this automatically via dotenv (imported in eleventy.config.js).
# In production, set these as Cloudflare Pages environment variables.

# Public URL of this Gazette site (no trailing slash)
GAZETTE_URL=https://imbryk-gazette.pages.dev

# Public URL of the Imbryk submission app (no trailing slash)
IMBRYK_APP_URL=https://imbryk.pages.dev
