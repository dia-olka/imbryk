# ── Imbryk app environment variables ──────────────────────────────────────────
# Copy to .env.local for local development.
# In production, set these as Cloudflare Pages environment variables.

# Public URL of this app (no trailing slash)
VITE_APP_URL=https://whisper.imbryk.news

# Public URL of the Gazette site
VITE_GAZETTE_URL=https://imbryk.news

# URL of the ingestion API backend
VITE_API_URL=https://your-ingestion-api.run.app
